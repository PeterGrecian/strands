[Unit]
Description=eclipticam end-of-night sync to bigstore 'bs' + ship-and-free local SSD
Documentation=file:/home/peter/super/strands/astro-storage/DESIGN-bs-nightly-sync.md
# bs is an NFS (soft) mount; if it's down the tool bails non-destructively.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Runs as peter: the tool ships via rsync-over-ssh using peter's SSH key, and
# its files live under /home/peter. A system unit defaults to root (%h=/root),
# which both mislocates the executable and lacks the key — so User is required.
User=peter
# --go: actually copy + verify + ship-and-free (keeps newest 3 nights local).
# Drop --go to make this a dry-run unit while validating.
ExecStart=/home/peter/super/bin/eclipticam-ship-night --go
Nice=10
IOSchedulingClass=idle
