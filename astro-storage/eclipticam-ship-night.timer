[Unit]
Description=Daily end-of-night eclipticam -> bigstore sync (astro-storage strand)
Documentation=file:%h/super/strands/astro-storage/DESIGN-bs-nightly-sync.md

[Timer]
# ~09:00 Europe/London — capture is night-only, so by 09:00 the night tree is
# complete and static. Timezone-aware (handles BST/GMT).
OnCalendar=*-*-* 09:00:00 Europe/London
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
