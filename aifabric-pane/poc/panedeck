#!/usr/bin/env bash
# panedeck — open the aifabric-pane deck in its own dedicated terminal window.
#
# The scrollbar belongs to the OUTER terminal emulator (xfce4-terminal), not to
# tmux or the deck, so we launch a dedicated window with the scrollbar (and menu/
# tool bars) hidden and attach the deck inside it. Only THIS window loses its
# scrollbar; your other terminals keep theirs.
#
# If the deck ('pane' tmux session) isn't running yet, we rebuild it first from
# the current mondrian via restart-deck.sh.
#
#   --dynamic-title-mode=none  keeps the window titled 'pane' — the CLI twin of
#   the TITLE_HIDE trick (see dotfiles CLAUDE.md: stops the backend rewriting the
#   tab title every turn, so the deck window stays identifiable in the panel).
#
# Usage:  panedeck [mondrian-name]     (mondrian only used if a rebuild is needed)
set -uo pipefail

DECK="${DECK:-pane}"
HERE="$(dirname "$(readlink -f "$0")")"
MON="${1:-current}"

# Refuse to nest: attaching a deck from inside tmux is prefix-key hell.
if [[ -n "${TMUX:-}" ]]; then
  echo "panedeck: you're already inside tmux — run from a plain terminal." >&2
  exit 1
fi

# Build the deck if it isn't up. restart-deck builds detached and does NOT attach.
if ! tmux has-session -t "$DECK" 2>/dev/null; then
  echo "panedeck: '$DECK' not running — building from mondrian '$MON'..."
  bash "$HERE/restart-deck.sh" "$MON" || { echo "panedeck: build failed" >&2; exit 1; }
fi

# Open a dedicated, chrome-free window titled "$DECK" and attach the deck in it.
# --dynamic-title-mode=none freezes the title so both the panel label AND our
# fullscreen-by-title lookup below stay valid (the backend can't rewrite it).
xfce4-terminal \
  --hide-scrollbar \
  --hide-menubar \
  --hide-toolbar \
  --initial-title="$DECK" \
  --dynamic-title-mode=none \
  --command "tmux attach -t $DECK" &

# Assert TRUE fullscreen after the window maps. xfce4-terminal's own
# --fullscreen loses a race with the WM at map time and silently falls back to
# MAXIMIZED (panel + titlebar still eat the top of the screen), so we don't use
# it — we re-assert via wmctrl once the window exists. Match by exact title
# (which we froze above), newest window wins if several are titled "$DECK".
for _ in $(seq 1 50); do
  wid="$(xdotool search --name "^${DECK}\$" 2>/dev/null | tail -1)"
  [[ -n "${wid:-}" ]] && break
  sleep 0.1
done

if [[ -n "${wid:-}" ]]; then
  wmctrl -i -r "$wid" -b add,fullscreen 2>/dev/null \
    && echo "panedeck: '$DECK' fullscreen on window $wid"
else
  echo "panedeck: opened '$DECK' but couldn't find the window to fullscreen it; press F11." >&2
fi
